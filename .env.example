# =============================================================================
# LexiconAndroid destination registry - template.
#
# This module ships to customers as a compiled APK: it never asks the user for a
# server address, so every network destination it talks to must be baked in at
# build time from the SAME registry every other module uses.
#
# LAYERING (lowest -> highest priority), applied by app/build.gradle.kts at
# Gradle configuration time:
#   1. destinations.defaults.json (committed) - so this module builds standalone
#      when cloned by itself, with no root checkout around it.
#   2. the ROOT `.env` (../.env relative to this module, or $MASTER_ENV_FILE) -
#      overrides the same keys, silently ignored if absent.
#   3. real process environment variables (highest priority).
#
# Only the keys below are ever read from the root `.env`; nothing else is baked
# into the app, and secrets (tokens, passwords, keystores) can never appear here.
#
# This file itself is not read by Gradle - it exists purely to document the keys
# and their standalone-default values, matching destinations.defaults.json and
# the root .env.example. To override locally without editing tracked files, set
# a real environment variable, or point MASTER_ENV_FILE at a root .env.
# =============================================================================

LAN_HOST=192.168.1.4
ALISON_LAN_IP=192.168.1.2
LEXICON_PORT=36568
ALCHEMY_PORT=8080
POKEMON_PORT=8090
BRAIN_LAN_PORT=9080

PUBLIC_LEXICON_URL=https://api.alex-dyakin.com
PUBLIC_ALCHEMY_URL=https://alchemy.alex-dyakin.com
PUBLIC_POKEMON_URL=https://poke.alex-dyakin.com
PUBLIC_BRIDGE_URL=https://voice.alex-dyakin.com
PUBLIC_BRAIN_URL=https://llm.alex-dyakin.com
