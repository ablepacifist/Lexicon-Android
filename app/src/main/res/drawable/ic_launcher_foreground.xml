<?xml version="1.0" encoding="utf-8"?>
<!-- The Lexicon cube itself. Sized 72x68dp inside the 108dp adaptive canvas: that
     keeps it within the 72dp safe zone every launcher mask honours, and 72:68
     matches the artwork's 600:570 aspect so it is not stretched. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="72dp"
        android:height="68dp"
        android:gravity="center"
        android:drawable="@drawable/logo_lexicon" />
</layer-list>
