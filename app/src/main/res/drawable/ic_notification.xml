<?xml version="1.0" encoding="utf-8"?>
<!-- Status bar icon. Android masks this to a flat silhouette, so it must be a solid
     white shape on transparency - the full-colour cube would render as a grey blob.
     Simplified cube outline: top face plus two side faces. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <!-- Cube silhouette -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,2 L21,7 L21,17 L12,22 L3,17 L3,7 Z M12,4.3 L5,8.2 L5,15.8 L12,19.7 L19,15.8 L19,8.2 Z" />
    <!-- Inner rune mark -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,7.5 L16,9.7 L16,14.3 L12,16.5 L8,14.3 L8,9.7 Z" />
</vector>
