<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose supplies the real theming; this only covers the window before
         the first frame, so the app doesn't flash white on launch. -->
    <style name="Theme.Lexicon" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
    </style>
</resources>
