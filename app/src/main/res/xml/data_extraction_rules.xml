<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing of the app's is carried to another device. Since Android 12, allowBackup="false"
  stops cloud backup but not a device-to-device transfer, which would copy the encrypted
  preferences (the sign-in token, Lexi's agent token) to a phone whose keystore cannot
  decrypt them: the app then fails to read its own settings until its data is cleared.
  Signing in again on the new phone is the intended path.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
