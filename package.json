{
  "name": "lexicon-android",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor shell that packages the Lexicon web build and the Mumble voice client into an installable Android APK.",
  "scripts": {
    "bundle": "powershell -ExecutionPolicy Bypass -File ./scripts/build.ps1",
    "sync": "cap sync android",
    "apk": "powershell -ExecutionPolicy Bypass -File ./scripts/build.ps1 -Apk",
    "open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "typescript": "^7.0.2"
  }
}
